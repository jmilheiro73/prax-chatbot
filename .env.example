# Copie para `.env` na RAIZ do repo (é o único lugar lido; `.env` é gitignored).

# --- P1 ---
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# --- D3 · checkpoint de curto prazo (Redis com TTL) ---
REDIS_URL=redis://localhost:6379
# aula: 86400 (24h) · teste local: 60 (1 minuto -> a chave some)
CHECKPOINT_TTL_SECONDS=60

# --- D3 · sumarização (longo prazo desta entrega) ---
# aula: ~4000 · teste local: 10 (qualquer mensagem longa dispara a compactação)
SUMMARY_TOKEN_LIMIT=10
# mensagens recentes que sobrevivem à compactação (0 = fica só o summary)
SUMMARY_KEEP_LAST=0
SUMMARY_DB_PATH=data/summaries.sqlite

# --- D3 · LangSmith (AC-04) ---
LANGSMITH_TRACING=true
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=prax-chatbot

# --- front ---
# CORS_ORIGINS=["http://localhost:3000"]
