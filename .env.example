# Copie para `.env` na RAIZ do repo (é o único lugar lido; `.env` é gitignored).

# --- P1 ---
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# --- D3 · checkpoint de curto prazo (Redis com TTL) ---
REDIS_URL=redis://localhost:6379
# aula: 86400 (24h) · teste local: 60 (1 minuto -> a chave some)
CHECKPOINT_TTL_SECONDS=60

# --- D3 · sumarização (longo prazo desta entrega) ---
# aula: ~4000 · teste local: 10 (qualquer mensagem longa dispara a compactação)
SUMMARY_TOKEN_LIMIT=10
# mensagens recentes que sobrevivem à compactação (0 = fica só o summary)
SUMMARY_KEEP_LAST=0
SUMMARY_DB_PATH=data/summaries.sqlite

# --- D3 · LangSmith (AC-04) ---
LANGSMITH_TRACING=true
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=prax-chatbot

# --- front ---
# CORS_ORIGINS=["http://localhost:3000"]

# --- Durável: conversas, memórias e documentos ---
# APP_DB_PATH=data/prax.sqlite
# APP_TIMEZONE=America/Sao_Paulo

# --- RAG ---
# EMBEDDING_MODEL=text-embedding-3-small
# EMBEDDING_DIMS=1536
# RAG_TOP_K=5
# RAG_CHUNK_TOKENS=400
# Enriquecimento contextual: melhora a busca, mas custa uma chamada de LLM por trecho novo.
# RAG_ENRICH=false
# HNSW_M=16
# HNSW_EF_CONSTRUCTION=64

# --- Memória de longo prazo ---
# MEMORY_ENABLED=true
# MEMORY_MIN_SIMILARITY=0.35

# --- Subagente: vazio usa o OPENAI_MODEL ---
# SUBAGENT_MODEL=

# --- MCP ---
# Liga a rota /mcp. É o token de quem conecta, não a chave da OpenAI. Vazio = rota desligada.
# MCP_SERVER_TOKEN=
# Servidores externos que o agente consome, com filtro por glob:
# MCP_SERVERS=[{"name": "x", "url": "https://exemplo/mcp", "token": "...", "allow": ["list_*"]}]
